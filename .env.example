# 配置模板：程序启动时自动读取项目根目录 .env，进程环境变量优先覆盖同名配置。
# 复制为 .env 后填写本地密钥；.env 已被 Git 忽略，禁止提交真实密钥。

# 运行环境
APP_ENV=development
LOG_LEVEL=INFO

# 工作区，只允许智能体操作该目录
WORKSPACE_ROOT=./workspace

# 数据库路径（相对路径以 WORKSPACE_ROOT 为基准）
DATABASE_PATH=./data/likai_nexus.db

# Git Bash 路径；Windows 可填写 bash.exe 的绝对路径，留空则从 PATH 查找
BASH_PATH=

# 模型角色
MODEL_PLANNER=gpt-5.6-sol
MODEL_IMPLEMENTER=gpt-5.6-luna
MODEL_REVIEWER=gpt-5.6-sol

# 模型服务配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
MODEL_TIMEOUT_SECONDS=60

# 执行限制
DEFAULT_BASH_TIMEOUT_SECONDS=30
MAX_BASH_TIMEOUT_SECONDS=120
MAX_OUTPUT_BYTES=65536
MAX_READ_LINES=2000
MAX_READ_BYTES=65536
MAX_TURNS=20

# 飞书，第二阶段使用
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 微信，后续评估
WECHAT_ENABLED=false

# 安全配置
REQUIRE_APPROVAL_FOR_WRITE=true
REQUIRE_APPROVAL_FOR_COMMAND=true
ALLOW_NETWORK_ACCESS=false
