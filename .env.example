# 配置模板：程序启动时自动读取当前工作目录 .env，进程环境变量优先覆盖同名配置。
# 复制为 .env 后填写本地密钥；.env 已被 Git 忽略，禁止提交真实密钥。

# 运行环境
APP_ENV=development
LOG_LEVEL=INFO

# 工作区，只允许智能体操作该目录
WORKSPACE_ROOT=./workspace

# 数据库路径（相对路径以项目根目录为基准；留空时使用项目根目录 data/likai_nexus.db）
DATABASE_PATH=./data/likai_nexus.db

# Git Bash 路径；Windows 建议填写 Git Bash 的绝对路径，留空时不会使用 WSL bash.exe
BASH_PATH=

# 模型角色
MODEL_PLANNER=gpt-5.6-sol
MODEL_IMPLEMENTER=gpt-5.6-luna
MODEL_REVIEWER=gpt-5.6-sol

# 模型服务配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
MODEL_TIMEOUT_SECONDS=60

# PostgreSQL/pgvector（当前默认仍使用 SQLite；切换时由运行时显式组装）
POSTGRES_DSN=postgresql://likai@127.0.0.1:5432/likai_nexus

# 豆包 Embedding（火山方舟 OpenAI 兼容接口；不填写 API Key 时不会发起请求）
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_MODEL=doubao-embedding-text-240715
EMBEDDING_DIMENSION=2560
EMBEDDING_TIMEOUT_SECONDS=60

# 执行限制
DEFAULT_BASH_TIMEOUT_SECONDS=30
MAX_BASH_TIMEOUT_SECONDS=120
MAX_OUTPUT_BYTES=65536  # 包含正文和回填模型的工具状态，必须至少为 132
MAX_READ_LINES=2000
MAX_READ_BYTES=65408  # read 请求正文上限；最终有效值还会扣除 128 字节状态信封
MAX_TURNS=50

# 飞书，第二阶段使用
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 微信，后续评估
WECHAT_ENABLED=false
